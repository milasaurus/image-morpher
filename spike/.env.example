# ANTHROPIC_MODEL=claude-sonnet-4-6
# SPIKE_PROMPT=a vintage typewriter on a wooden desk
# SEED_A=warm lighting
# SEED_B=cool lighting
# WINNER=B
# WEIGHT_STYLE_REF=0.55
# WEIGHT_MODIFY_IMAGE_REF=0.85
